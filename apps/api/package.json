{
	"name": "@pulsewatch/api",
	"version": "1.0.0",
	"private": true,
	"type": "commonjs",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc",
		"start": "node dist/server.js",
		"typecheck": "tsc --noEmit",
		"worker": "tsx watch src/workers/monitor.worker.ts",
		"worker:start": "node dist/workers/monitor.worker.js",
		"email:worker": "tsx watch src/workers/notification.worker.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:redis": "vitest run --config vitest.redis.config.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"argon2": "^0.45.2",
		"bullmq": "^6.7.8",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^18.0.10",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.5",
		"helmet": "^8.3.0",
		"ioredis": "^6.0.0",
		"ipaddr.js": "^2.5.0",
		"jsonwebtoken": "^9.0.3",
		"nodemailer": "^10.6.1",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"prisma": "^7.10.1",
		"supertest": "^7.3.2",
		"tsx": "^4.23.15",
		"vitest": "^5.1.2"
	}
}

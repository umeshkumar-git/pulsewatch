generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MonitorStatus {
  UNKNOWN
  UP
  DOWN
  PAUSED
}

enum MonitorMethod {
  GET
  HEAD
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  DELIVERY_UNKNOWN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  monitors    Monitor[]
  statusPages StatusPage[]

  refreshSessions RefreshSession[]

  @@map("users")
}

model Monitor {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  name              String
  url               String        @db.Text
  method            MonitorMethod @default(GET)
  intervalSeconds   Int           @default(60) @map("interval_seconds")
  timeoutMs         Int           @default(10000) @map("timeout_ms")
  failureThreshold  Int           @default(3) @map("failure_threshold")
  recoveryThreshold Int           @default(2) @map("recovery_threshold")
  status            MonitorStatus @default(UNKNOWN)
  enabled           Boolean       @default(true)
  checkGeneration   BigInt        @default(0) @map("check_generation")
  lastCheckedAt     DateTime?     @map("last_checked_at") @db.Timestamptz(3)
  nextCheckAt       DateTime?     @map("next_check_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkResults CheckResult[]
  incidents    Incident[]
  statusPages  StatusPageMonitor[]

  @@index([userId])
  @@index([enabled, nextCheckAt])
  @@map("monitors")
}

model CheckResult {
  id           String   @id @default(uuid()) @db.Uuid
  monitorId    String   @map("monitor_id") @db.Uuid
  statusCode   Int?     @map("status_code")
  latencyMs    Int?     @map("latency_ms")
  success      Boolean
  errorMessage String?  @map("error_message") @db.Text
  checkedAt    DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt(sort: Desc)])
  @@map("check_results")
}

model Incident {
  id           String         @id @default(uuid()) @db.Uuid
  monitorId    String         @map("monitor_id") @db.Uuid
  status       IncidentStatus @default(OPEN)
  failureCount Int            @default(0) @map("failure_count")
  startedAt    DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  resolvedAt   DateTime?      @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  monitor       Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([monitorId, status])
  @@map("incidents")
}

model StatusPage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  slug      String   @unique
  isPublic  Boolean  @default(true) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors StatusPageMonitor[]

  @@map("status_pages")
}

model StatusPageMonitor {
  statusPageId String   @map("status_page_id") @db.Uuid
  monitorId    String   @map("monitor_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  statusPage StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  monitor    Monitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([statusPageId, monitorId])
  @@map("status_page_monitors")
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  incidentId   String              @map("incident_id") @db.Uuid
  channel      NotificationChannel @default(EMAIL)
  eventType    NotificationEvent   @default(INCIDENT_OPENED) @map("event_type")
  recipient    String
  status       NotificationStatus  @default(PENDING)
  errorMessage String?             @map("error_message") @db.Text
  sentAt       DateTime?           @map("sent_at") @db.Timestamptz(3)
  attemptStartedAt  DateTime? @map("attempt_started_at") @db.Timestamptz(3)
providerMessageId String?   @map("provider_message_id")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, channel, recipient, eventType])
  @@index([status, createdAt])
  @@map("notifications")
}

model RefreshSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  tokenHash String @unique @map("token_hash")
  familyId  String @map("family_id") @db.Uuid

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_sessions")
}

enum NotificationEvent {
  INCIDENT_OPENED
  INCIDENT_RESOLVED

  @@map("notification_event")
}
